<!DOCTYPE html>
<html>
<head>
    <title>Mozijegy foglalás</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h1 class="mb-4">Mozijegy foglalás</h1>
        
        <% if (errors) { %>
            <div class="alert alert-danger">
                <% errors.forEach(error => { %>
                    <p class="mb-0"><%= error %></p>
                <% }); %>
            </div>
        <% } %>

        <form method="POST" action="/">
            <div class="mb-3">
                <label for="name" class="form-label">Név</label>
                <input type="text" class="form-control" id="name" name="name" required 
                       value="<%= oldData ? oldData.name : '' %>">
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email cím</label>
                <input type="email" class="form-control" id="email" name="email" required
                       value="<%= oldData ? oldData.email : '' %>">
            </div>

            <div class="mb-3">
                <label for="dateTime" class="form-label">Dátum és időpont</label>
                <input type="datetime-local" class="form-control" id="dateTime" name="dateTime" required
                       min="<%= new Date().toISOString().slice(0, 16) %>"
                       value="<%= oldData ? oldData.dateTime : '' %>">
            </div>

            <div class="mb-3">
                <label for="numberOfGuests" class="form-label">Nézők száma (1-10)</label>
                <input type="number" class="form-control" id="numberOfGuests" name="numberOfGuests" 
                       min="1" max="10" required
                       value="<%= oldData ? oldData.numberOfGuests : '' %>">
            </div>

            <button type="submit" class="btn btn-primary">Foglalás</button>
        </form>
    </div>
</body>
</html>
